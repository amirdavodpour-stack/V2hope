# HOPE backend local-development example. Never use these values in staging/production.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATA_FILE=./data/hope.json
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=
RATE_LIMIT_STORE=memory
ACCESS_TOKEN_SECRET=local-only-change-me-access-please
REFRESH_TOKEN_SECRET=local-only-change-me-refresh-please
ACCESS_TOKEN_ISSUER=hope-api
ACCESS_TOKEN_AUDIENCE=hope-mobile
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
RESET_TOKEN_TTL=900
RESET_TOKEN_DELIVERY_MODE=console
RESET_TOKEN_DELIVERY_URL=
RESET_TOKEN_DELIVERY_SECRET=
EXPOSE_RESET_TOKEN_IN_DEVELOPMENT=true
ALLOWED_CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
TRUSTED_PROXY_IPS=
MAX_REQUEST_BYTES=1048576
MAX_UPLOAD_BYTES=10485760
MAX_CONCURRENT_UPLOADS=4
PG_POOL_MAX=10
STORAGE_BACKEND=local
STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=uploads
S3_SERVER_SIDE_ENCRYPTION=AES256
UPLOAD_INTENT_TTL_SECONDS=300
METRICS_TOKEN=
PAYMENT_PROVIDER=simulator
PAYMENT_CURRENCY=USD
PAYMENT_WEBHOOK_SECRET=
PAYMENT_PROVIDER_TOKEN=
PAYMENT_PROVIDER_CREATE_URL=
PAYMENT_PROVIDER_RELEASE_URL=
PAYMENT_PROVIDER_REFUND_URL=
PAYMENT_PROVIDER_TIMEOUT_MS=5000
PAYMENT_PROVIDER_MAX_ATTEMPTS=3
PAYMENT_PROVIDER_RETRY_BASE_MS=100
PAYMENT_WEBHOOK_MAX_AGE_SECONDS=300
NOTIFICATION_PUSH_URL=
NOTIFICATION_EMAIL_URL=
NOTIFICATION_PROVIDER_TOKEN=
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_BASE_MS=100
NOTIFICATION_DELIVERY_TIMEOUT_MS=5000
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
ALERT_WEBHOOK_TIMEOUT_MS=3000
OUTBOX_POLL_MS=1000
OUTBOX_WORKER_CONCURRENCY=4
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_LEASE_SECONDS=60
MAX_IDEMPOTENCY_KEY_LENGTH=200
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=5000
